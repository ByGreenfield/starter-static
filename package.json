{
  "name": "starter-static",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:smoke": "playwright test",
    "gen:agents": "node scripts/gen-agent-files.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && node scripts/gen-agent-files.mjs --check && pnpm test:unit && pnpm build && pnpm test:smoke"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "description": "Greenfield starter-static: a brochure site template (Next.js static export + Tailwind) managed through Greenfield Swarm.",
  "engines": {
    "node": ">=22"
  }
}
